ARG RUNTIME_BASE_IMAGE=registry.redhat.io/ubi9/ubi-minimal-pqc@sha256:c7fdcf2617a608d07f95fa01d8936fc8bf898096a60e5ebc432aae8ead50ea6c

FROM registry.access.redhat.com/ubi9/ubi-minimal:9.7@sha256:907b68736aa798b2d38255b7aa070b2a70acb90803864a40f05d0ec47556ddd0 AS builder

RUN microdnf install -y gcc gcc-c++ pkgconf make perl cargo \
    && microdnf clean all

WORKDIR /src

COPY Cargo.toml Cargo.lock ./
COPY .cargo/ ./.cargo/
COPY libs/ ./libs/
COPY connectors/ ./connectors/
COPY services/ ./services/

RUN if [ -f /cachi2/cachi2.env ]; then . /cachi2/cachi2.env; fi && \
    cargo build --release -p rest-service && \
    cp target/release/rest-service /usr/local/bin/rest-service

FROM ${RUNTIME_BASE_IMAGE}
WORKDIR /

COPY --from=builder --chown=root:root --chmod=0555 \
    /usr/local/bin/rest-service /app/rest-service

USER 1001:1001

ENTRYPOINT ["/app/rest-service"]
